    {
        "id": "36138bd7a70b717a",
        "type": "function",
        "z": "f2c30f269ef07f19",
        "name": "map2InfluxDBPoint",
        "func": "const sensor = msg.payload;\n\nif (!sensor || typeof sensor !== \"object\") {\n    node.error(\"Expected a JSON sensor object in msg.payload\", msg);\n\n    return null;\n}\n\nconst timestamp = new Date(sensor.last_logged);\n\nif (isNaN(timestamp.getTime())) {\n    node.error(`Invalid last_logged timestamp: ${sensor.last_logged}`, msg);\n\n    return null;\n}\n\nconst measurementByCategory = {\n    environment: \"environment\",\n    meteo: \"weather\"\n}\n\nconst measurement = measurementByCategory[sensor.category];\n\nif (!measurement) {\n    node.warn(`Unsupported sensor type: ${sensor.category}`)\n}\n\nconst fields = {};\n\nfunction addNumber(sourceKey, fieldKey) {\n    if (Number.isFinite(sensor[sourceKey])) {\n        fields[fieldKey] = sensor[sourceKey];\n    }\n}\n\n// Readings shared by thermometers and the weather station\naddNumber(\"tempc\", \"temperature_c\");\naddNumber(\"hum\", \"humidity_pct\");\n\n// Category-specific readings\nif (sensor.category == \"environment\") {\n    addNumber(\"batt\", \"battery_pct\");\n}\n\nif (sensor.category === \"meteo\") {\n    // true/false is a clearer representation than the collector's 1/0.\n    if (sensor.battery_ok === 0 || sensor.battery_ok === 1) {\n        fields.battery_ok = Boolean(sensor.battery_ok);\n    }\n\n    addNumber(\"wind_dir_deg\", \"wind_direction_deg\");\n    addNumber(\"wind_avg_m_s\", \"wind_speed_avg_m_s\");\n    addNumber(\"wind_max_m_s\", \"wind_gust_m_s\");\n    addNumber(\"rain_mm\", \"rain_total_mm\");\n    addNumber(\"uv\", \"uv\");\n    addNumber(\"uvi\", \"uv_index\");\n    addNumber(\"light_lux\", \"illuminance_lux\");\n    addNumber(\"pressure_hPa\", \"pressure_hPa\");\n}\n\nif (Object.keys(fields).length == 0) {\n    node.warn(\"No usable sensor readings found.\");\n\n    return null;\n}\n\nconst tags = {\n    device_id: String(sensor.id),\n    house: String(sensor.house),\n    room: String(sensor.room),\n    sensor_name: String(sensor.name),\n    sensor_type: String(sensor.type),\n    brand: String(sensor.brand),\n    model: String(sensor.model),\n    radio_frequency: String(sensor.frequency)\n};\n\n// Omit absent optional tags rather than storing \"undefined\".\nfor (const [key, value] of Object.entries(tags)) {\n    if (!value || value == \"undefined\") {\n        delete tags[key];\n    }\n}\n\nmsg.payload = [{\n    measurement,\n    fields,\n    tags,\n    timestamp\n}];\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 710,
        "y": 260,
        "wires": [
            [
                "91944188da96c6e1",
                "a89eec763e4a7b8e"
            ]
        ]
    },
    {
        "id": "dc505af710fedf0e",
        "type": "function",
        "z": "f2c30f269ef07f19",
        "name": "sanitiseEnvironment",
        "func": "delete msg.payload.pressure_hPa;\n\nmsg.payload.category = 'environment';\n\nlet modelParts = msg.payload.model.split('-');\n\nmsg.payload.brand =\n    !!modelParts.length ? modelParts[0] : 'ecowit';\nmsg.payload.name =\n    modelParts.length > 1\n        ? modelParts[1] + '_' + msg.payload.id\n        : msg.payload.id;\n\nmsg.topic = msg.topic.replace('meteo', 'environment');\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 240,
        "wires": [
            [
                "684f8ba18c8a7c88"
            ]
        ]
    },
