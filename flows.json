    {
        "id": "17cfa0e6ea5f484d",
        "type": "function",
        "z": "f2c30f269ef07f19",
        "name": "Add Meteo Msg",
        "func": "let meteoMsg = RED.util.cloneMessage(msg);\n\ndelete meteoMsg.payload.tempc;\ndelete meteoMsg.payload.hum;\n\ndelete msg.payload.pressure_hPa;\n\nmsg.payload.category = 'environment';\n\nlet modelParts = msg.payload.model.split('-');\n\nmsg.payload.brand =\n    !!modelParts.length ? modelParts[0] : 'ecowit';\nmsg.payload.name =\n    modelParts.length > 1 \n        ? modelParts[1] + '_' + msg.payload.id\n        : msg.payload.id;\n\nmsg.topic = msg.topic.replace('meteo', 'environment');\n\nreturn [msg, meteoMsg];",
